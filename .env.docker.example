POSTGRES_DB=token
POSTGRES_USER=token
POSTGRES_PASSWORD=replace-with-a-long-random-password
TOKEN_DATABASE_URL=postgresql+psycopg://token:replace-with-a-long-random-password@postgres:5432/token
TOKEN_PORT=8000
TOKEN_ENVIRONMENT=production
TOKEN_ADMIN_TOKEN=replace-with-a-long-random-admin-token
TOKEN_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
TOKEN_TRIAL_SIGNING_SECRET=replace-with-a-long-random-trial-secret
TOKEN_TRIAL_TOKEN_TTL_SECONDS=604800
TOKEN_PUBLIC_BASE_URL=https://token.example.com
TOKEN_CORS_ORIGINS=
TOKEN_MAX_REQUEST_BODY_BYTES=1048576
TOKEN_API_RATE_LIMIT_REQUESTS=120
TOKEN_API_RATE_LIMIT_WINDOW_SECONDS=60
TOKEN_PORTAL_RATE_LIMIT_REQUESTS=60
TOKEN_PORTAL_RATE_LIMIT_WINDOW_SECONDS=60
TOKEN_MOCK_MODE=false
TOKEN_SEED_BUILTIN_MODELS=false
TOKEN_DEFAULT_PROVIDER_BASE_URL=http://host.docker.internal:4000/v1
TOKEN_DEFAULT_PROVIDER_API_KEY=
TOKEN_PROVIDER_TIMEOUT_SECONDS=120
TOKEN_CHANNEL_HEALTH_TIMEOUT_SECONDS=10
TOKEN_MAX_CHANNEL_ATTEMPTS=3
TOKEN_CHANNEL_FAILURE_THRESHOLD=3
TOKEN_CHANNEL_CIRCUIT_COOLDOWN_SECONDS=60
TOKEN_WECHAT_MERCHANT_ID=
TOKEN_WECHAT_APP_ID=
TOKEN_WECHAT_CERTIFICATE_SERIAL=
TOKEN_WECHAT_PRIVATE_KEY_PATH=
TOKEN_ALIPAY_APP_ID=
TOKEN_ALIPAY_PRIVATE_KEY_PATH=
TOKEN_ALIPAY_PUBLIC_KEY_PATH=
